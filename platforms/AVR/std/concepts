namespace std
{
    template<typename T, typename U>
    struct is_same
    {
        static constexpr bool value = false;
    };

    template<typename T>
    struct is_same<T, T>
    {
        static constexpr bool value = true;
    };

    template<typename T, typename U>
    concept same_as = is_same<T, U>::value && is_same<U, T>::value;
}